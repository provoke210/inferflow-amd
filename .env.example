INFERFLOW_MODE=fake
# Real mode: run scripts/configure_amd.py locally; never paste keys into chat.
INFERFLOW_AMD_API_KEY=
INFERFLOW_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Fake limits below are NOT documented AMD limits. Replace from your account UI.
INFERFLOW_RPM=120
INFERFLOW_CONCURRENCY=3
INFERFLOW_LIMITS_CONFIRMED=false
# Local rolling 24h budget counts ALL outbound attempts incl. metadata & retries.
INFERFLOW_DAILY_BUDGET=10
INFERFLOW_QUEUE_SIZE=64
INFERFLOW_CACHE_TTL=3600
INFERFLOW_DB_PATH=data/inferflow.sqlite3
